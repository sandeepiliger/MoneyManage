<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the handful of colours needed before Compose takes over. The full palette lives in
  Color.kt so light and dark stay in one place rather than split across Kotlin and XML.
-->
<resources>
    <color name="window_background">#FAFAFC</color>
    <color name="brand_indigo">#3A3A8C</color>
    <color name="brand_brass">#C29300</color>
    <color name="launcher_background">#3A3A8C</color>

    <!-- Home-screen widget. RemoteViews cannot read the Compose theme, so it has its own. -->
    <color name="widget_surface">#FFFFFF</color>
    <color name="widget_on_surface">#1B1B24</color>
    <color name="widget_muted">#5C5C6E</color>
    <color name="widget_primary">#3A3A8C</color>
    <color name="widget_on_primary">#FFFFFF</color>
    <color name="widget_secondary">#E6E6F4</color>
    <color name="widget_on_secondary">#2A2A6E</color>
</resources>
