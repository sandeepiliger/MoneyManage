<?xml version="1.0" encoding="utf-8"?>
<!--
  Android's automatic cloud backup is disabled entirely (android:allowBackup="false" in the
  manifest); this file documents the intent and takes effect on any path that still consults it.

  Financial records are not silently copied to Google Drive. A user who wants their data
  elsewhere uses the app's own export, which is explicit, inspectable and under their control.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
